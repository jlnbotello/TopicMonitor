<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- This project hosts the real ASP.NET Core server in-process (TopicMonitor.Server); the test host's apphost
         needs the same roll-forward as TopicMonitor.Server itself to start on a machine that only has a newer
         shared runtime (e.g. .NET 10) and not an exact 8.0.x match. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Excludes the real-time latency suite ("separate category") from a plain
         "dotnet test" with no filter option. "dotnet test" with a filter option passes that expression to
         MSBuild as the global property VSTestTestCaseFilter, and global properties set on the command line
         always win over a project file's own assignment to the same property - so passing the filter option
         with "Category=Latency" overrides this default and runs exactly that suite, while omitting the
         filter option falls back to this value and excludes it. -->
    <VSTestTestCaseFilter>Category!=Latency</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="HdrHistogram" Version="2.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TopicMonitor.Server\TopicMonitor.Server.csproj" />
    <ProjectReference Include="..\..\src\TopicMonitor.Client\TopicMonitor.Client.csproj" />
    <ProjectReference Include="..\..\src\TopicMonitor.Contracts\TopicMonitor.Contracts.csproj" />
  </ItemGroup>

</Project>